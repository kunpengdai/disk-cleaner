    "level": 0, "mode": "contents", "note": "网页缓存，删除后网页首次打开会稍慢。建议先关闭 Edge。" },
  { "id": "firefox-cache", "name": "Firefox 浏览器缓存", "category": "浏览器",
    "paths": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2"], "level": 0, "mode": "contents",
