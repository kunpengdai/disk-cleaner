  { "id": "browser-profile", "name": "浏览器用户数据", "category": "浏览器",
    "paths": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data", "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "%APPDATA%\\Mozilla\\Firefox\\Profiles"],
