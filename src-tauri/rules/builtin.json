[
  { "id": "user-temp", "name": "用户临时文件", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\Temp"], "level": 0, "mode": "contents",
    "note": "程序运行时留下的临时文件。正在使用的文件会被自动跳过。" },
  { "id": "win-temp", "name": "系统临时文件", "category": "系统",
    "paths": ["%SystemRoot%\\Temp"], "level": 0, "mode": "contents",
    "note": "系统和安装程序留下的临时文件，通常需要管理员权限才能删除。" },
  { "id": "wu-download", "name": "Windows 更新下载缓存", "category": "系统",
    "paths": ["%SystemRoot%\\SoftwareDistribution\\Download"], "level": 0, "mode": "contents",
    "note": "已经安装完的更新包。删除后不影响系统，正在进行的更新会重新下载。需要管理员权限。" },
  { "id": "delivery-opt", "name": "传递优化缓存", "category": "系统",
    "paths": ["%SystemRoot%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache"],
    "level": 0, "mode": "contents", "note": "用于给局域网其他电脑分享更新的缓存。需要管理员权限。" },
  { "id": "thumbcache", "name": "缩略图缓存", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db", "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\iconcache_*.db"],
    "level": 0, "mode": "self", "note": "资源管理器的图片预览缓存，会自动重建。正在使用的会被跳过。" },
  { "id": "inetcache", "name": "IE / 系统网页缓存", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"], "level": 0, "mode": "contents",
    "note": "系统组件使用的网页缓存。" },
  { "id": "wer", "name": "错误报告", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive", "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue"],
    "level": 0, "mode": "contents", "note": "程序崩溃后生成的错误报告。" },
  { "id": "crash-dumps", "name": "程序崩溃转储", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\CrashDumps", "%SystemRoot%\\Minidump"], "level": 0, "mode": "contents",
    "note": "程序或系统崩溃时保存的内存快照，只有排查问题时才需要。" },
  { "id": "memory-dmp", "name": "系统内存转储", "category": "系统",
    "paths": ["%SystemRoot%\\MEMORY.DMP"], "level": 0, "mode": "self",
    "note": "蓝屏时保存的完整内存快照，通常很大。需要管理员权限。" },
  { "id": "d3dscache", "name": "DirectX 着色器缓存", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\D3DSCache"], "level": 0, "mode": "contents",
    "note": "游戏和图形程序的着色器缓存，会自动重建，首次运行可能稍慢。" },
  { "id": "gpu-cache", "name": "显卡驱动缓存", "category": "系统",
    "paths": ["%LOCALAPPDATA%\\NVIDIA\\DXCache", "%LOCALAPPDATA%\\NVIDIA\\GLCache", "%LOCALAPPDATA%\\AMD\\DxCache", "%LOCALAPPDATA%\\AMD\\DxcCache"],
    "level": 0, "mode": "contents", "note": "显卡驱动的着色器缓存，会自动重建。" },
  { "id": "recycle-bin", "name": "回收站", "category": "系统",
    "paths": ["*:\\$Recycle.Bin"], "level": 1, "mode": "empty_recycle_bin",
    "note": "清空后，回收站里的文件将无法再还原。" },
  { "id": "windows-old", "name": "旧版 Windows 安装", "category": "系统",
    "paths": ["%SystemDrive%\\Windows.old"], "level": 1, "mode": "self",
    "note": "系统升级前的旧版本。删除后无法回退到旧版本。",
    "alt": "这个文件夹权限特殊，建议在 设置 → 系统 → 存储 → 临时文件 中勾选“以前的 Windows 安装”删除。" },
  { "id": "wu-relocated", "name": "Windows 更新临时下载（其他盘）", "category": "系统",
    "paths": ["*:\\WUDownloadCache"], "level": 1, "mode": "contents",
    "note": "系统盘空间不足时，Windows 更新会把下载的更新包临时放在其他盘的这个文件夹里。更新装好后可以清理；正在更新时请不要删除。" },
  { "id": "do-relocated", "name": "传递优化缓存（其他盘）", "category": "系统",
    "paths": ["*:\\DeliveryOptimization\\Cache"], "level": 1, "mode": "contents",
    "note": "传递优化的缓存被设置到了这个盘。删除后不影响系统，需要时会重新下载。" },

  { "id": "chrome-cache", "name": "Chrome 浏览器缓存", "category": "浏览器",
    "paths": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\ShaderCache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GrShaderCache"],
