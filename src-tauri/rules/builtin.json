  { "id": "downloads", "name": "下载目录", "category": "个人文件",
    "paths": ["%USERPROFILE%\\Downloads", "{known:Downloads}"], "level": 1, "mode": "self", "quick": false,
    "note": "你下载的文件。请确认不再需要后再删除。" },
  { "id": "personal", "name": "个人文件", "category": "个人文件",
    "paths": ["%USERPROFILE%\\Documents", "%USERPROFILE%\\Desktop", "%USERPROFILE%\\Pictures", "%USERPROFILE%\\Videos", "%USERPROFILE%\\Music", "{known:Documents}", "{known:Desktop}", "{known:Pictures}", "{known:Videos}", "{known:Music}"],
    "level": 2, "mode": "self", "note": "你的个人文件（文档、照片、视频等）。删除前请确认已备份。" },
  { "id": "onedrive", "name": "OneDrive 同步目录", "category": "个人文件",
    "paths": ["%USERPROFILE%\\OneDrive", "%USERPROFILE%\\OneDrive - *"], "level": 2, "mode": "self",
    "note": "云同步目录。删除这里的文件，云端的文件也会被一起删除。" },
  { "id": "appdata", "name": "应用数据", "category": "软件",
    "paths": ["%USERPROFILE%\\AppData", "%APPDATA%", "%LOCALAPPDATA%", "%USERPROFILE%\\AppData\\LocalLow"],
    "level": 2, "mode": "self", "note": "软件的配置、登录状态和数据。直接删除可能导致软件需要重新登录、设置丢失或无法启动。" },
  { "id": "program-files", "name": "已安装的软件", "category": "软件",
    "paths": ["*:\\Program Files", "*:\\Program Files (x86)"], "level": 2, "mode": "self",
    "note": "已安装软件的程序文件。直接删除会导致软件无法使用，也无法正常卸载。",
    "alt": "建议在 设置 → 应用 → 已安装的应用 中卸载软件。" },
  { "id": "program-data", "name": "软件公共数据", "category": "软件",
    "paths": ["%ProgramData%"], "level": 2, "mode": "self",
